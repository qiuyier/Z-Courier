{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Z-Courier Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": { "$ref": "#/definitions/positiveInteger" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "$ref": "#/definitions/nonNegativeInteger" },
        "runAsGroup": { "$ref": "#/definitions/nonNegativeInteger" },
        "fsGroup": { "$ref": "#/definitions/nonNegativeInteger" }
      }
    },
    "securityContext": { "type": "object" },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routeMsgIDs": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonNegativeInteger" }
        }
      }
    },
    "zinx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "tcpPort": { "$ref": "#/definitions/port" },
        "mode": { "type": "string", "enum": ["tcp"] },
        "maxConn": { "$ref": "#/definitions/positiveInteger" },
        "maxPacketSize": { "$ref": "#/definitions/positiveInteger" },
        "workerPoolSize": { "$ref": "#/definitions/nonNegativeInteger" },
        "maxWorkerTaskLen": { "$ref": "#/definitions/nonNegativeInteger" },
        "maxMsgChanLen": { "$ref": "#/definitions/nonNegativeInteger" },
        "ioReadBuffSize": { "$ref": "#/definitions/nonNegativeInteger" },
        "heartbeatMax": { "$ref": "#/definitions/nonNegativeInteger" },
        "logDir": { "type": "string" },
        "logFile": { "type": "string" },
        "logCons": { "type": "boolean" },
        "logIsolationLevel": { "$ref": "#/definitions/nonNegativeInteger" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["http", "static"] },
        "staticTokens": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/staticToken" }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "internalTokenEnv": { "$ref": "#/definitions/envName" },
            "timeout": { "$ref": "#/definitions/duration" },
            "maxInFlight": { "$ref": "#/definitions/nonNegativeInteger" }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxEntries": { "$ref": "#/definitions/nonNegativeInteger" },
            "positiveTTL": { "$ref": "#/definitions/duration" },
            "negativeTTL": { "$ref": "#/definitions/duration" }
          }
        }
      }
    },
    "internalHttp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/definitions/port" },
        "maxRequestBodySize": { "$ref": "#/definitions/positiveInteger" },
        "maxInFlight": { "$ref": "#/definitions/nonNegativeInteger" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["hmac"] },
            "hmac": { "$ref": "#/definitions/hmacConfig" }
          }
        }
      }
    },
    "adminConsole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "assetsDir": { "type": "string", "minLength": 1 },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prometheusURL": { "type": "string" },
            "grafanaURL": { "type": "string" },
            "dashboardURL": { "type": "string" }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "ttl": { "$ref": "#/definitions/duration" },
            "cookieName": { "type": "string", "minLength": 1 },
            "cookieSecure": { "type": "boolean" },
            "cookieSameSite": {
              "type": "string",
              "enum": ["lax", "strict", "none"]
            },
            "role": {
              "type": "string",
              "enum": ["readonly", "operator", "admin"]
            },
            "store": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["memory", "redis"]
                },
                "redis": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "addr": { "type": "string" },
                    "username": { "type": "string" },
                    "passwordEnv": { "$ref": "#/definitions/envName" },
                    "db": { "$ref": "#/definitions/nonNegativeInteger" },
                    "keyPrefix": { "type": "string", "minLength": 1 },
                    "dialTimeout": { "$ref": "#/definitions/duration" },
                    "readTimeout": { "$ref": "#/definitions/duration" },
                    "writeTimeout": { "$ref": "#/definitions/duration" },
                    "operationTimeout": { "$ref": "#/definitions/duration" }
                  }
                }
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["memory", "postgres"]
            },
            "capacity": { "$ref": "#/definitions/nonNegativeInteger" },
            "postgres": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dsn": { "type": "string" },
                "autoMigrate": { "type": "boolean" },
                "maxOpenConns": { "$ref": "#/definitions/nonNegativeInteger" },
                "maxIdleConns": { "$ref": "#/definitions/nonNegativeInteger" },
                "connMaxLifetime": { "$ref": "#/definitions/duration" },
                "operationTimeout": { "$ref": "#/definitions/duration" }
              }
            }
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "routeRefreshInterval": { "$ref": "#/definitions/duration" },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["redis", "memory"] },
            "ttl": { "$ref": "#/definitions/duration" },
            "redis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "addr": { "type": "string", "minLength": 1 },
                "username": { "type": "string" },
                "passwordEnv": { "$ref": "#/definitions/envName" },
                "db": { "$ref": "#/definitions/nonNegativeInteger" },
                "keyPrefix": { "type": "string", "minLength": 1 },
                "dialTimeout": { "$ref": "#/definitions/duration" },
                "readTimeout": { "$ref": "#/definitions/duration" },
                "writeTimeout": { "$ref": "#/definitions/duration" }
              }
            }
          }
        },
        "peer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": { "$ref": "#/definitions/duration" },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "type": "string", "enum": ["hmac"] },
                "hmac": { "$ref": "#/definitions/hmacConfig" }
              }
            }
          }
        }
      }
    },
    "downlink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["memory", "postgres", "none", "disabled"]
            },
            "postgres": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dsn": { "type": "string" },
                "autoMigrate": { "type": "boolean" },
                "maxOpenConns": { "$ref": "#/definitions/nonNegativeInteger" },
                "maxIdleConns": { "$ref": "#/definitions/nonNegativeInteger" },
                "connMaxLifetime": { "$ref": "#/definitions/duration" }
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retryInterval": { "$ref": "#/definitions/duration" },
            "retryDelay": { "$ref": "#/definitions/duration" },
            "retryJitter": { "$ref": "#/definitions/duration" },
            "ackTimeout": { "$ref": "#/definitions/duration" },
            "retryLease": { "$ref": "#/definitions/duration" },
            "maxAttempts": { "$ref": "#/definitions/nonNegativeInteger" },
            "scanLimit": { "$ref": "#/definitions/nonNegativeInteger" },
            "bindFlushLimit": { "$ref": "#/definitions/nonNegativeInteger" },
            "retryFairness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "candidateMultiplier": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                }
              }
            }
          }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/downlinkPolicy" }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxPendingGlobal": { "$ref": "#/definitions/nonNegativeInteger" },
            "maxPendingPerDevice": { "$ref": "#/definitions/nonNegativeInteger" }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publisher": { "$ref": "#/definitions/terminalPublisher" },
            "retryInterval": { "$ref": "#/definitions/duration" },
            "retryDelay": { "$ref": "#/definitions/duration" },
            "retryJitter": { "$ref": "#/definitions/duration" },
            "backoffMultiplier": { "type": "number", "minimum": 1 },
            "maxRetryDelay": { "$ref": "#/definitions/duration" },
            "retryLease": { "$ref": "#/definitions/duration" },
            "scanLimit": { "$ref": "#/definitions/nonNegativeInteger" }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deliveredTTL": { "$ref": "#/definitions/duration" },
            "failedTTL": { "$ref": "#/definitions/duration" },
            "discardedTTL": { "$ref": "#/definitions/duration" },
            "cleanupInterval": { "$ref": "#/definitions/duration" },
            "cleanupLimit": { "$ref": "#/definitions/nonNegativeInteger" }
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowlist": { "$ref": "#/definitions/policyList" },
        "blocklist": { "$ref": "#/definitions/policyList" },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxRequests": { "$ref": "#/definitions/nonNegativeInteger" },
            "window": { "$ref": "#/definitions/duration" }
          }
        },
        "trafficPolicies": { "$ref": "#/definitions/trafficPolicies" }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "rateLimit": {
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              },
              "trafficPolicies": {
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              }
            },
            "required": ["rateLimit", "trafficPolicies"]
          }
        }
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/upstreamRoute" }
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authProviderSharedToken": { "type": "string", "minLength": 1 },
            "internalHMACSecret": { "type": "string", "minLength": 1 },
            "peerHMACSecret": { "type": "string", "minLength": 1 },
            "postgresPassword": { "type": "string", "minLength": 1 },
            "redisPassword": { "type": "string", "minLength": 1 },
            "terminalWebhookHMACSecret": { "type": "string", "minLength": 1 },
            "upstreamInternalToken": { "type": "string", "minLength": 1 }
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authProviderSharedToken": { "type": "string" },
            "internalHMACSecret": { "type": "string" },
            "peerHMACSecret": { "type": "string" },
            "postgresPassword": { "type": "string" },
            "redisPassword": { "type": "string" },
            "terminalWebhookHMACSecret": { "type": "string" },
            "upstreamInternalToken": { "type": "string" }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": { "type": "object" }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": { "type": "object" }
    },
    "clientService": { "$ref": "#/definitions/service" },
    "internalService": { "$ref": "#/definitions/service" },
    "headlessService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "$ref": "#/definitions/duration" },
        "scrapeTimeout": { "$ref": "#/definitions/duration" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "oneOf": [
            { "$ref": "#/definitions/nonNegativeInteger" },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ]
        }
      }
    },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "minLength": 1
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "staticToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "token_id"],
      "properties": {
        "client_id": { "type": "string", "minLength": 1 },
        "token_id": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hmacConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyID": { "type": "string", "minLength": 1 },
        "secretEnv": { "$ref": "#/definitions/envName" },
        "additionalKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/hmacAdditionalKey" }
        },
        "maxClockSkew": { "$ref": "#/definitions/duration" },
        "nonceTTL": { "$ref": "#/definitions/duration" },
        "maxNonceEntries": { "$ref": "#/definitions/nonNegativeInteger" }
      }
    },
    "hmacAdditionalKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyID", "secretEnv"],
      "properties": {
        "keyID": { "type": "string", "minLength": 1 },
        "secretEnv": { "$ref": "#/definitions/envName" }
      }
    },
    "downlinkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled", "msgIDMin"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "enabled": { "type": "boolean" },
        "msgIDMin": { "$ref": "#/definitions/positiveInteger" },
        "msgIDMax": { "$ref": "#/definitions/nonNegativeInteger" },
        "maxAttempts": { "$ref": "#/definitions/positiveInteger" },
        "maxAge": { "$ref": "#/definitions/duration" },
        "ackTimeout": { "$ref": "#/definitions/duration" },
        "retryDelay": { "$ref": "#/definitions/duration" },
        "backoffMultiplier": { "type": "number", "minimum": 1 },
        "maxRetryDelay": { "$ref": "#/definitions/duration" },
        "retryJitter": { "$ref": "#/definitions/duration" }
      }
    },
    "terminalPublisher": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["none"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "nsq"],
          "properties": {
            "type": { "type": "string", "enum": ["nsq"] },
            "nsq": { "$ref": "#/definitions/terminalNSQTarget" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "http"],
          "properties": {
            "type": { "type": "string", "enum": ["http"] },
            "http": { "$ref": "#/definitions/terminalHTTPTarget" }
          }
        }
      ]
    },
    "terminalNSQTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nsqdAddrs",
        "topic",
        "authSecret",
        "dialTimeout",
        "readTimeout",
        "writeTimeout",
        "publishMode",
        "retryAttempts"
      ],
      "properties": {
        "nsqdAddrs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "topic": { "type": "string", "minLength": 1 },
        "authSecret": { "type": "string" },
        "dialTimeout": { "$ref": "#/definitions/duration" },
        "readTimeout": { "$ref": "#/definitions/duration" },
        "writeTimeout": { "$ref": "#/definitions/duration" },
        "publishMode": { "type": "string", "enum": ["round_robin"] },
        "retryAttempts": { "$ref": "#/definitions/nonNegativeInteger" }
      }
    },
    "terminalHTTPTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "timeout", "allowInsecureHTTP", "hmac"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://", "minLength": 1 },
        "timeout": { "$ref": "#/definitions/duration" },
        "allowInsecureHTTP": { "type": "boolean" },
        "hmac": { "$ref": "#/definitions/terminalHTTPHMAC" },
        "tls": { "$ref": "#/definitions/terminalHTTPTLS" }
      }
    },
    "terminalHTTPHMAC": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyID", "secretEnv"],
      "properties": {
        "keyID": { "type": "string", "minLength": 1 },
        "secretEnv": { "$ref": "#/definitions/envName" }
      }
    },
    "terminalHTTPTLS": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "serverName": { "type": "string", "minLength": 1 },
        "secret": { "$ref": "#/definitions/terminalHTTPTLSSecret" }
      },
      "anyOf": [
        { "required": ["serverName"] },
        { "required": ["secret"] }
      ]
    },
    "terminalHTTPTLSSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mountPath", "caKey", "clientCertKey", "clientKeyKey"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "mountPath": { "type": "string", "minLength": 2, "pattern": "^/" },
        "caKey": { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "clientCertKey": { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "clientKeyKey": { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      },
      "anyOf": [
        { "properties": { "caKey": { "minLength": 1 } } },
        { "properties": { "clientCertKey": { "minLength": 1 } } },
        { "properties": { "clientKeyKey": { "minLength": 1 } } }
      ],
      "allOf": [
        {
          "if": { "properties": { "clientCertKey": { "minLength": 1 } } },
          "then": { "properties": { "clientKeyKey": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "clientKeyKey": { "minLength": 1 } } },
          "then": { "properties": { "clientCertKey": { "minLength": 1 } } }
        }
      ]
    },
    "policyList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientIDs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "msgIDs": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonNegativeInteger" }
        }
      }
    },
    "trafficPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "maxKeys",
        "idleTTL",
        "defaultPolicy",
        "policies"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["local", "redis"]
        },
        "maxKeys": { "$ref": "#/definitions/nonNegativeInteger" },
        "idleTTL": { "$ref": "#/definitions/duration" },
        "defaultPolicy": { "type": "string" },
        "redis": { "$ref": "#/definitions/trafficPolicyRedis" },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/trafficPolicy" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "policies": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "const": "redis" }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["redis"]
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "const": "local" }
            },
            "required": ["mode"]
          },
          "then": {
            "not": {
              "required": ["redis"]
            }
          }
        }
      ]
    },
    "trafficPolicyRedis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addr",
        "username",
        "passwordEnv",
        "db",
        "keyPrefix",
        "dialTimeout",
        "readTimeout",
        "writeTimeout",
        "operationTimeout",
        "failureMode"
      ],
      "properties": {
        "addr": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "passwordEnv": { "$ref": "#/definitions/envName" },
        "db": { "$ref": "#/definitions/nonNegativeInteger" },
        "keyPrefix": { "type": "string", "minLength": 1 },
        "dialTimeout": { "$ref": "#/definitions/duration" },
        "readTimeout": { "$ref": "#/definitions/duration" },
        "writeTimeout": { "$ref": "#/definitions/duration" },
        "operationTimeout": { "$ref": "#/definitions/duration" },
        "failureMode": {
          "type": "string",
          "enum": ["fail_closed"]
        }
      }
    },
    "trafficPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "enabled",
        "priority",
        "match",
        "key",
        "tokenBucket"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "enabled": { "type": "boolean" },
        "priority": { "$ref": "#/definitions/positiveInteger" },
        "match": { "$ref": "#/definitions/trafficPolicyMatch" },
        "key": {
          "type": "string",
          "enum": ["client_id"]
        },
        "tokenBucket": { "$ref": "#/definitions/trafficPolicyTokenBucket" }
      }
    },
    "trafficPolicyMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "msgIDMin": { "$ref": "#/definitions/positiveInteger" },
        "msgIDMax": { "$ref": "#/definitions/positiveInteger" },
        "routes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "dependencies": {
        "msgIDMax": ["msgIDMin"]
      }
    },
    "trafficPolicyTokenBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "refillTokens", "refillInterval"],
      "properties": {
        "capacity": { "$ref": "#/definitions/positiveInteger" },
        "refillTokens": { "$ref": "#/definitions/positiveInteger" },
        "refillInterval": { "$ref": "#/definitions/duration" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "initialDelaySeconds": { "$ref": "#/definitions/nonNegativeInteger" },
        "periodSeconds": { "$ref": "#/definitions/positiveInteger" },
        "timeoutSeconds": { "$ref": "#/definitions/positiveInteger" },
        "failureThreshold": { "$ref": "#/definitions/positiveInteger" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "$ref": "#/definitions/port" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "upstreamRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled", "msgIDMin", "msgIDMax", "target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "msgIDMin": { "$ref": "#/definitions/positiveInteger" },
        "msgIDMax": { "$ref": "#/definitions/positiveInteger" },
        "target": {
          "oneOf": [
            { "$ref": "#/definitions/httpTarget" },
            { "$ref": "#/definitions/nsqTarget" }
          ]
        }
      }
    },
    "httpTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tokenEnv", "timeout", "maxInFlight"],
      "properties": {
        "type": { "type": "string", "enum": ["http"] },
        "url": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^/([^/?#][^?#]*)?$"
        },
        "tokenEnv": { "$ref": "#/definitions/envName" },
        "timeout": { "$ref": "#/definitions/duration" },
        "maxInFlight": { "$ref": "#/definitions/nonNegativeInteger" },
        "discovery": { "$ref": "#/definitions/httpDiscovery" },
        "failover": { "$ref": "#/definitions/httpFailover" }
      },
      "oneOf": [
        {
          "required": ["url"],
          "not": {
            "anyOf": [
              { "required": ["path"] },
              { "required": ["discovery"] },
              { "required": ["failover"] }
            ]
          }
        },
        {
          "required": ["discovery"],
          "properties": {
            "discovery": { "$ref": "#/definitions/httpStaticDiscovery" }
          },
          "not": {
            "anyOf": [
              { "required": ["url"] },
              { "required": ["path"] }
            ]
          }
        },
        {
          "required": ["discovery"],
          "properties": {
            "discovery": { "$ref": "#/definitions/httpDNSDiscovery" }
          },
          "not": { "required": ["url"] }
        }
      ]
    },
    "httpDiscovery": {
      "oneOf": [
        { "$ref": "#/definitions/httpStaticDiscovery" },
        { "$ref": "#/definitions/httpDNSDiscovery" }
      ]
    },
    "httpStaticDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "endpoints"],
      "properties": {
        "type": { "type": "string", "enum": ["static"] },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "httpDNSDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scheme", "hostname", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["dns"] },
        "scheme": { "type": "string", "enum": ["http", "https"] },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "$ref": "#/definitions/port" },
        "refreshInterval": { "$ref": "#/definitions/duration" }
      }
    },
    "httpFailover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxAttempts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "unhealthyCooldown": { "$ref": "#/definitions/duration" }
      },
      "oneOf": [
        {
          "properties": {
            "enabled": { "enum": [true] }
          }
        },
        {
          "properties": {
            "enabled": { "enum": [false] }
          },
          "not": {
            "anyOf": [
              { "required": ["maxAttempts"] },
              { "required": ["unhealthyCooldown"] }
            ]
          }
        }
      ]
    },
    "nsqTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "nsqdAddrs",
        "topic",
        "authSecret",
        "dialTimeout",
        "readTimeout",
        "writeTimeout",
        "publishMode",
        "retryAttempts",
        "maxInFlight"
      ],
      "properties": {
        "type": { "type": "string", "enum": ["nsq"] },
        "nsqdAddrs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "topic": { "type": "string", "minLength": 1 },
        "authSecret": { "type": "string" },
        "dialTimeout": { "$ref": "#/definitions/duration" },
        "readTimeout": { "$ref": "#/definitions/duration" },
        "writeTimeout": { "$ref": "#/definitions/duration" },
        "publishMode": { "type": "string", "enum": ["round_robin"] },
        "retryAttempts": { "$ref": "#/definitions/nonNegativeInteger" },
        "maxInFlight": { "$ref": "#/definitions/nonNegativeInteger" }
      }
    }
  }
}
