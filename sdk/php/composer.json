{
  "name": "z-courier/sdk",
  "description": "Protocol and client SDK for Z-Courier",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "ZCourier\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress"
  }
}
